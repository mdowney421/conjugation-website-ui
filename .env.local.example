# Copy to .env.local and fill in for the feedback widget (src/components/FeedbackWidget.tsx,
# src/app/api/feedback/route.ts) to actually send email. Get an API key at https://resend.com.
#
# Without a verified domain, Resend's shared onboarding@resend.dev sender only delivers to the
# email address on your Resend account -- fine for wiring this up and testing it yourself. Once
# you've bought a domain and verified it with Resend, set RESEND_FROM_EMAIL to an address on it
# so anyone's feedback can be delivered.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Trekluent <onboarding@resend.dev>"

# Where feedback submissions get sent.
CONTACT_EMAIL=
