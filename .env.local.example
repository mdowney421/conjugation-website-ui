# The deployed FastAPI backend (see src/languages/api.ts). Falls back to
# http://127.0.0.1:8000 for local development if unset.
NEXT_PUBLIC_API_BASE_URL=https://wfk1o1413e.execute-api.us-east-1.amazonaws.com

# The canonical production URL. Used to resolve metadataBase (src/app/layout.tsx,
# for OpenGraph/canonical links), the sitemap (src/app/sitemap.ts), and robots.txt
# (src/app/robots.ts). Must be set in the production environment (e.g. Vercel project
# settings) -- without it, the sitemap falls back to localhost URLs, which search
# engines cannot index.
NEXT_PUBLIC_SITE_URL=https://dialectrek.com

# Copy to .env.local and fill in for the feedback widget (src/components/FeedbackWidget.tsx,
# src/app/api/feedback/route.ts) to actually send email. Get an API key at https://resend.com.
#
# Without a verified domain, Resend's shared onboarding@resend.dev sender only delivers to the
# email address on your Resend account -- fine for wiring this up and testing it yourself. Once
# you've bought a domain and verified it with Resend, set RESEND_FROM_EMAIL to an address on it
# so anyone's feedback can be delivered.
RESEND_API_KEY=random-alphanumeric-string
RESEND_FROM_EMAIL="DialecTrek <feedback@dialectrek.com>"

# Where feedback submissions get sent.
CONTACT_EMAIL=my-email-address